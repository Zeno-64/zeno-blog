---
/** A janela com a luz correndo na borda — a assinatura visual dos três
 *  domínios. `quieta`: luz parada até passar o mouse (para grades). */
interface Props {
  titulo: string
  direita?: string
  luz?: 'azul' | 'gelo' | 'vermelha'
  quieta?: boolean
  class?: string
}
const { titulo, direita, luz = 'azul', quieta = false, class: classe } = Astro.props
---

<div
  class:list={[
    'moldura-luz',
    { 'luz-gelo': luz === 'gelo', 'luz-vermelha': luz === 'vermelha', 'moldura-quieta': quieta },
    classe,
  ]}
>
  <div class="h-full overflow-hidden rounded-[17px] bg-vidro/95">
    <div class="flex items-center gap-2 border-b border-white/[0.06] px-4 py-2.5">
      <span class="size-2.5 rounded-full bg-white/10" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-white/10" aria-hidden="true"></span>
      <span class="size-2.5 rounded-full bg-azul" aria-hidden="true"></span>
      <span class="ml-2 min-w-0 truncate font-mono text-[0.7rem] text-suave">{titulo}</span>
      {direita && <span class="ml-auto shrink-0 font-mono text-[0.62rem] text-fraco">{direita}</span>}
    </div>
    <slot />
  </div>
</div>
