---
import { existsSync } from 'node:fs'
import { getEntry, render } from 'astro:content'
import Indice from '../../components/Indice.astro'
import Base from '../../layouts/Base.astro'
import {
  COR_TIPO,
  dataISO,
  formatarData,
  minutosLeitura,
  nomeTransicao,
  postsVisiveis,
  ROTULO_TIPO,
  slugTag,
  urlPost,
  type Post,
} from '../../lib/posts'
import { SITE } from '../../lib/site'

export async function getStaticPaths() {
  const posts = await postsVisiveis()
  // lista do mais novo para o mais antigo: "anterior" é o mais velho
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, maisNovo: posts[i - 1], maisVelho: posts[i + 1] },
  }))
}

interface Props {
  post: Post
  maisNovo?: Post
  maisVelho?: Post
}

const { post, maisNovo, maisVelho } = Astro.props
const { titulo, descricao, data, atualizado, tipo, tags, fontes, revisao, rascunho } = post.data
const { Content, headings } = await render(post)

const serie = post.data.serie ? await getEntry(post.data.serie) : undefined
const partesDaSerie = serie
  ? (await postsVisiveis((p) => p.data.serie?.id === serie.id)).sort((a, b) => (a.data.parte ?? 0) - (b.data.parte ?? 0))
  : []
const trilha = post.data.trilha ? await getEntry(post.data.trilha) : undefined
const titulosIndice = headings.filter((h) => h.depth === 2 || h.depth === 3)

// imagem de prévia própria (npm run og) ou a padrão do blog
const imagem = existsSync(`public/og/posts/${post.id}.jpg`) ? `/og/posts/${post.id}.jpg` : SITE.ogPadrao
const url = new URL(urlPost(post), Astro.site).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: descricao,
  datePublished: data.toISOString(),
  dateModified: (atualizado ?? data).toISOString(),
  inLanguage: 'pt-BR',
  url,
  mainEntityOfPage: url,
  image: new URL(imagem, Astro.site).href,
  keywords: tags.join(', '),
  author: { '@type': 'Person', name: SITE.autor, url: SITE.autorUrl },
}
---

<Base titulo={titulo} descricao={descricao} imagem={imagem} artigo={{ publicado: data, atualizado, tags }} barraLeitura>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article data-pagefind-body class="pt-10 md:pt-16">
    <!-- ============ Cabeçalho ============ -->
    <header class="max-w-3xl">
      <nav aria-label="Você está em" class="font-mono text-xs text-suave" data-pagefind-ignore>
        <a href="/posts/" class="hover:text-azul-claro">~/posts</a>
        <span class="text-fraco">/</span>
        <span class="text-texto">{post.id}</span>
      </nav>

      <!-- fora do índice da busca (o filtro de tipo continua valendo) -->
      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-suave" data-pagefind-ignore>
        <a href={tipo === 'til' ? '/til/' : `/posts/#${tipo}`} class:list={['selo', COR_TIPO[tipo]]} data-pagefind-filter="tipo">
          {ROTULO_TIPO[tipo]}
        </a>
        <time datetime={dataISO(data)} data-pagefind-meta="data">{formatarData(data)}</time>
        {
          atualizado && (
            <span>
              · atualizado em <time datetime={dataISO(atualizado)}>{formatarData(atualizado)}</time>
            </span>
          )
        }
        <span aria-hidden="true" class="text-fraco">·</span>
        <span>{minutosLeitura(post)} min de leitura</span>
        {rascunho && <span class="selo selo-ambar">rascunho — não aparece no site publicado</span>}
      </div>

      <h1
        class="titulo-marca mt-4 text-[2.3rem] md:text-[3.4rem]"
        style={`view-transition-name: ${nomeTransicao(post)}`}
        data-pagefind-meta="title"
      >
        {titulo}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-branco-frio md:text-xl">{descricao}</p>

      {
        tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((tag) => (
              <li>
                <a
                  href={`/tags/${slugTag(tag)}/`}
                  class="rounded-md border border-white/[0.08] px-2 py-0.5 font-mono text-[0.7rem] text-suave transition hover:border-azul-claro/40 hover:text-titulo"
                >
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <!-- ============ Série e trilha ============ -->
    {
      serie && partesDaSerie.length > 0 && (
        <aside class="mt-10 max-w-3xl rounded-2xl border border-gelo/20 bg-gelo/[0.04] p-5" aria-label="Série">
          <p class="font-mono text-xs text-gelo">
            série · parte {partesDaSerie.findIndex((p) => p.id === post.id) + 1} de {partesDaSerie.length}
          </p>
          <p class="mt-1 font-marca text-lg font-bold italic text-titulo">
            <a href={`/series/${serie.id}/`} class="hover:text-gelo-claro">
              {serie.data.nome}
            </a>
          </p>
          <ol class="mt-3 space-y-1 text-sm">
            {partesDaSerie.map((p, i) => (
              <li class="flex gap-3">
                <span class="w-5 shrink-0 font-mono text-xs leading-6 text-fraco">{i + 1}.</span>
                {p.id === post.id ? (
                  <span class="text-titulo" aria-current="page">
                    {p.data.titulo}
                  </span>
                ) : (
                  <a href={urlPost(p)} class="text-texto hover:text-azul-claro">
                    {p.data.titulo}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </aside>
      )
    }

    <!-- ============ Texto + índice ============ -->
    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <div class="min-w-0 max-w-3xl">
        {
          titulosIndice.length >= 2 && (
            <details class="mb-10 rounded-2xl border border-white/[0.07] bg-vidro/50 px-5 py-3 lg:hidden">
              <summary class="cursor-pointer font-mono text-xs text-suave">índice deste post</summary>
              <ol class="mt-3 space-y-1.5 pb-1 text-sm">
                {titulosIndice.map((h) => (
                    <li class:list={{ 'pl-4': h.depth === 3 }}>
                      <a href={`#${h.slug}`} class="text-texto hover:text-azul-claro">
                        {h.text}
                      </a>
                    </li>
                  ))}
              </ol>
            </details>
          )
        }

        <div class="prosa">
          <Content />
        </div>

        <!-- ============ Revisão ============ -->
        {
          revisao.length > 0 && (
            <section class="mt-16" aria-labelledby="para-revisar" data-pagefind-ignore>
              <h2 id="para-revisar" class="titulo-marca text-2xl">
                Para revisar
              </h2>
              <p class="mt-2 text-sm text-suave">
                Tente responder antes de abrir. Estas perguntas também entram na{' '}
                <a href="/revisao/" class="text-azul-claro hover:underline">
                  revisão espaçada
                </a>
                .
              </p>
              <div class="mt-5 space-y-3">
                {revisao.map((r) => (
                  <details class="group rounded-2xl border border-white/[0.07] bg-vidro/50 px-5 py-4 open:border-azul-claro/25">
                    <summary class="cursor-pointer list-none text-titulo marker:hidden">
                      <span class="mr-2 font-mono text-xs text-azul-claro">?</span>
                      {r.pergunta}
                    </summary>
                    <p class="mt-3 border-t border-white/[0.06] pt-3 leading-relaxed text-texto">{r.resposta}</p>
                  </details>
                ))}
              </div>
            </section>
          )
        }

        <!-- ============ Fontes ============ -->
        {
          fontes.length > 0 && (
            <section class="mt-14" aria-labelledby="fontes">
              <h2 id="fontes" class="font-mono text-xs uppercase tracking-[0.2em] text-azul-claro">
                // fontes e leitura
              </h2>
              <ul class="mt-4 space-y-2">
                {fontes.map((f) => (
                  <li>
                    <a href={f.url} target="_blank" rel="noopener noreferrer" class="text-texto hover:text-azul-claro">
                      {f.titulo} <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          trilha && (
            <p class="mt-14 rounded-2xl border border-azul/20 bg-azul/[0.05] px-5 py-4 text-sm text-texto" data-pagefind-ignore>
              Este post faz parte da trilha{' '}
              <a href={`/trilhas/${trilha.id}/`} class="font-medium text-azul-claro hover:underline">
                {trilha.data.nome}
              </a>
              . Lá estão o mapa do assunto e os próximos passos.
            </p>
          )
        }
      </div>

      <aside class="hidden lg:block" data-pagefind-ignore>
        <div class="sticky top-24">
          <Indice titulos={headings} />
        </div>
      </aside>
    </div>
  </article>

  <!-- ============ Navegação ============ -->
  <nav aria-label="Outros posts" class="mt-20 grid gap-4 border-t border-white/[0.06] pt-10 md:grid-cols-2">
    {
      maisVelho ? (
        <a href={urlPost(maisVelho)} class="group rounded-2xl border border-white/[0.06] p-5 transition hover:border-azul-claro/30">
          <span class="font-mono text-xs text-suave">← anterior</span>
          <span class="mt-1 block font-marca text-lg font-bold italic text-titulo group-hover:text-gelo-claro">
            {maisVelho.data.titulo}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      maisNovo && (
        <a
          href={urlPost(maisNovo)}
          class="group rounded-2xl border border-white/[0.06] p-5 text-right transition hover:border-azul-claro/30"
        >
          <span class="font-mono text-xs text-suave">próximo →</span>
          <span class="mt-1 block font-marca text-lg font-bold italic text-titulo group-hover:text-gelo-claro">
            {maisNovo.data.titulo}
          </span>
        </a>
      )
    }
  </nav>
</Base>

<script>
  // Botão "copiar" nos blocos de código e "#" nos títulos do texto
  document.querySelectorAll<HTMLPreElement>('.prosa pre').forEach((pre) => {
    const botao = document.createElement('button')
    botao.type = 'button'
    botao.className = 'copiar'
    botao.textContent = 'copiar'
    botao.setAttribute('aria-label', 'Copiar o código')
    botao.addEventListener('click', async () => {
      const codigo = pre.querySelector('code')?.innerText ?? pre.innerText
      try {
        await navigator.clipboard.writeText(codigo)
        botao.textContent = 'copiado'
        botao.dataset.ok = ''
      } catch {
        botao.textContent = 'erro'
      }
      setTimeout(() => {
        botao.textContent = 'copiar'
        delete botao.dataset.ok
      }, 1800)
    })
    pre.appendChild(botao)
  })

  document.querySelectorAll<HTMLHeadingElement>('.prosa :is(h2, h3, h4)[id]').forEach((h) => {
    const a = document.createElement('a')
    a.href = `#${h.id}`
    a.className = 'ancora'
    a.textContent = '#'
    a.setAttribute('aria-label', `Link para a seção ${h.textContent ?? ''}`)
    h.prepend(a)
  })
</script>
